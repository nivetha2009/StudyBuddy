# ---------------------------------------------------------------------------
# StudyBuddy server environment
# Copy this file to `.env` and fill in the values you need.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# Environment: development | production
NODE_ENV=development

# Comma separated list of origins allowed to call this API.
# Use * to allow any origin (safe when the API is same-origin with the site).
# On Vercel the deployment's own URL is allowed automatically.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# AI_PROVIDER options:
#   demo      -> no API key needed, returns realistic sample content (default)
#   openai    -> OpenAI or any OpenAI-compatible API (Groq, OpenRouter, Together, Ollama)
#   anthropic -> Anthropic Claude API
#   gemini    -> Google Gemini API
AI_PROVIDER=demo

# Your API key for the chosen provider. Leave empty to stay in demo mode.
AI_API_KEY=

# Model name for the chosen provider.
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-4-5
#   gemini    -> gemini-2.0-flash
AI_MODEL=gpt-4o-mini

# Only needed for openai-compatible providers with a different host.
#   OpenAI     -> https://api.openai.com/v1
#   Groq       -> https://api.groq.com/openai/v1
#   OpenRouter -> https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Generation settings
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.4
# Keep this below your host's function timeout (Vercel: 60s as configured in vercel.json).
AI_TIMEOUT_MS=50000

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# On Vercel use 4: serverless functions reject request bodies over ~4.5 MB.
MAX_FILE_SIZE_MB=15

# Left empty it defaults to ./uploads locally and /tmp/studybuddy-uploads on serverless hosts.
UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=120
