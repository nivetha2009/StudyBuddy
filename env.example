# ---------------------------------------------------------------------------
# StudyBuddy client environment
# Copy to `.env` inside the client folder.
#
# Only VITE_ prefixed values reach the browser, so NEVER put an AI API key here.
# The AI key lives in server/.env and is used only by the backend.
# ---------------------------------------------------------------------------

# Base URL of the StudyBuddy API.
# Local development can leave this empty: Vite proxies /api to localhost:5000.
# In production set it to your deployed backend, e.g. https://studybuddy-api.onrender.com
VITE_API_BASE_URL=

# Largest file the upload screen will accept, in MB.
# Keep this at or below the server's MAX_FILE_SIZE_MB.
# On Vercel, a serverless function rejects request bodies over ~4.5 MB, so use 4.
VITE_MAX_FILE_SIZE_MB=15
